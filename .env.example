# ---- Database: fill with YOUR existing Postgres container's details ----
# If that container publishes its port to the host, host.docker.internal
# works out of the box on Docker Desktop (Windows/Mac). See docker-compose.yml
# comments for the alternative (shared network) approach.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@host.docker.internal:5432/<dbname>

# ---- Redis / Celery (provided by this stack — leave as-is) ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- Security ----
# Generate with: openssl rand -hex 32   (or: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-value
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- External job APIs (free tier — sign up at https://developer.adzuna.com/) ----
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---- Embeddings ----
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Scraper ----
PLAYWRIGHT_HEADLESS=true
